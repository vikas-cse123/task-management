# ---------------------------------------------------------------------------
# Interscale Marketing - Project & Team Management System
#
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit a real `.env` file or real credentials.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# API (Express 5)
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=debug

# Database (MongoDB Atlas, or a local single-node replica set for transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/interscale_pm?replicaSet=rs0

# Isolated, replica-set-compatible database for @interscale/db integration tests.
# When unset, database integration tests are skipped. Never point this at
# development or production data.
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true

# Better Auth (used from the authentication step onward)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4000

# Trusted browser origin(s) for the SPA (comma separated)
WEB_ORIGIN=http://localhost:5173

# One-time initial admin bootstrap (used only by scripts/bootstrap-admin.ts).
# Never exposed to the frontend. Never logged. Never committed with real values.
INITIAL_ADMIN_EMAIL=admin@interscale.local
INITIAL_ADMIN_NAME=Interscale Admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password

# Background worker (Agenda v6)
WORKER_PROCESS_EVERY=30 seconds
AGENDA_DB_COLLECTION=agendaJobs
